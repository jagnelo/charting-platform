FROM python:3.12-slim
WORKDIR /runner
COPY research_runner ./research_runner
# Keep native numerical libraries inside the runner's explicit CPU budget. A
# user program may still vectorise, but it must not fan out unbounded BLAS
# threads inside a single isolated job.
ENV OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1
# These are installed at image build time only. User code receives restricted
# facades from runner.py, never the full modules or their filesystem/network APIs.
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
    "numpy==2.1.3" "pandas==2.2.3" "scipy==1.14.1" "statsmodels==0.14.4"
RUN useradd --create-home --uid 10001 runner
USER runner
CMD ["python", "-m", "research_runner.runner"]
