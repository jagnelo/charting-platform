# backend/.env.example — REFERENCE ONLY
# This file documents the environment variables the backend accepts.
# For Docker deployments: set these via the root .env file (see /.env.example).
# For local dev: they are loaded from backend/.env.dev via ENV_FILE=.env.dev.
# Do NOT copy this file anywhere — it is documentation only.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chartingdb
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/chartingdb
REDIS_URL=redis://redis:6379/0
SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost"]
ALERT_POLL_INTERVAL=60
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PROXY_FILE=proxies.txt
PROXY_ENABLED=false
INSTRUMENT_SYNC_SCHEDULE_ENABLED=false
DEFAULT_MARKET_DATA_PROVIDER=yfinance
DEFAULT_METADATA_PROVIDER=yfinance
DEFAULT_EVENT_PROVIDER=yfinance
DEFAULT_DISCOVERY_PROVIDER=yfinance
IDENTIFIER_PROVIDER_PRIORITY=["yfinance","openfigi"]
OPENFIGI_API_KEY=
MARKETDATA_API_KEY=
FMP_API_KEY=
INSTRUMENT_DISCOVERY_PAGE_DELAY_SECONDS=0.75
INSTRUMENT_METADATA_DELAY_SECONDS=1.0
INSTRUMENT_IDENTIFIER_DELAY_SECONDS=1.0
INSTRUMENT_DAILY_METADATA_CAP=750
INSTRUMENT_DAILY_IDENTIFIER_CAP=250
PROVIDER_MAX_CONCURRENCY=2
LOG_LEVEL=INFO
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
