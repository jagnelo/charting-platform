# backend/.env.example — REFERENCE ONLY
# This file documents the environment variables the backend accepts.
# For Docker deployments: set these via the root .env file (see /.env.example).
# For local dev: they are loaded from backend/.env.dev via ENV_FILE=.env.dev.
# Do NOT copy this file anywhere — it is documentation only.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chartingdb
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/chartingdb
REDIS_URL=redis://redis:6379/0
SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost"]
ALERT_POLL_INTERVAL=60
# Optional cross-host OHLCV refresh coalescing. Enable only when backend and
# worker share the same Redis coordinator; acquisition failure is fail-closed.
OHLCV_DISTRIBUTED_LOCK_ENABLED=false
OHLCV_DISTRIBUTED_LOCK_TTL_SECONDS=900
OHLCV_DISTRIBUTED_LOCK_WAIT_SECONDS=30
OHLCV_DISTRIBUTED_LOCK_RETRY_SECONDS=0.25
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PROXY_FILE=proxies.txt
PROXY_ENABLED=false
INSTRUMENT_SYNC_SCHEDULE_ENABLED=false
# Nightly canonical OHLCV refresh. Keep disabled until provider entitlements and
# quotas have been reviewed for the deployment; it never triggers paid fallback.
MARKET_DATA_REFRESH_SCHEDULE_ENABLED=false
ETF_HOLDINGS_CAPABILITY_CANARY_ENABLED=false
ETF_HOLDINGS_CAPABILITY_CANARY_SYMBOLS=DXJ,NTSX,MINT,BOND,GEME,TBIL,XBIL,OBIL,UTWO,UTRE,UFIV,USVN,UTEN,UTWY,UTHY
ETF_HOLDINGS_CAPABILITY_CANARY_MAX_SYMBOLS=20
ETF_HOLDINGS_CAPABILITY_CANARY_TIMEOUT_SECONDS=60
ETF_HOLDINGS_CAPABILITY_CANARY_FAILURE_THRESHOLD=3
ETF_HOLDINGS_CAPABILITY_CANARY_COOLDOWN_SECONDS=3600
MARKET_DATA_SHADOW_REPORT_ENABLED=false
# Optional provider-native account-usage snapshots. Every provider must be
# named explicitly; an empty list never means all providers.
PROVIDER_ACCOUNT_USAGE_REFRESH_ENABLED=false
PROVIDER_ACCOUNT_USAGE_REFRESH_PROVIDERS=[]
# Forward IPO/earnings/market-holiday ingestion; disabled until provider
# entitlements and redistribution terms are reviewed for the deployment.
MARKET_EVENTS_REFRESH_ENABLED=false
MARKET_EVENTS_REFRESH_LOOKAHEAD_DAYS=90
MARKET_EVENTS_REFRESH_MAX_PROVIDERS=8
MARKET_EVENTS_PRELISTING_ENABLED=false
MARKET_EVENTS_PRELISTING_LOOKAHEAD_DAYS=90
MARKET_EVENTS_PRELISTING_MAX_EVENTS=500
MARKET_EVENTS_EDGAR_UNIVERSE_SCAN_ENABLED=false
MARKET_EVENTS_EDGAR_UNIVERSE_SCAN_LOOKBACK_DAYS=365
MARKET_EVENTS_EDGAR_UNIVERSE_SCAN_MAX_ISSUERS=50
MARKET_EVENTS_EDGAR_UNIVERSE_SCAN_MAX_EVENTS_PER_ISSUER=100
# Complete SEC directory scan is separately disabled and fail-closed. One
# submissions request is made per CIK in each directory page; set a positive
# reviewed bound before enabling the feature.
MARKET_EVENTS_EDGAR_DIRECTORY_SCAN_ENABLED=false
MARKET_EVENTS_EDGAR_DIRECTORY_SCAN_MAX_ISSUERS=50
MARKET_EVENTS_EDGAR_DIRECTORY_SCAN_MAX_EVENTS_PER_ISSUER=100
MARKET_EVENTS_EDGAR_DIRECTORY_SCAN_MAX_SUBMISSIONS_REQUESTS=0
MARKET_EVENTS_EDGAR_DIRECTORY_SCAN_ISSUER_MATERIALIZATION_MODE=disabled
MARKET_EVENTS_EDGAR_DIRECTORY_SCAN_REVIEWED_CYCLE_COUNT=0
TOKENIZED_ASSET_REFRESH_ENABLED=false
TOKENIZED_ASSET_REFRESH_MAX_ASSETS=100
TOKENIZED_HISTORICAL_REFRESH_ENABLED=false
TOKENIZED_HISTORICAL_REFRESH_MAX_ASSETS=100
TOKENIZED_HISTORICAL_REFRESH_TIMESPAN=DAY
TOKENIZED_CATALOG_REFRESH_ENABLED=false
TOKENIZED_CATALOG_REFRESH_MAX_PAGES=1
TOKENIZED_CATALOG_REFRESH_PAGE_SIZE=100
TOKENIZED_EVENT_REFRESH_ENABLED=false
TOKENIZED_EVENT_REFRESH_MAX_PROVIDERS=2
TOKENIZED_EVENT_REFRESH_MAX_PAGES=1
TOKENIZED_EVENT_REFRESH_PAGE_SIZE=100
# Scheduled US venue/listing reconciliation is enabled by default; set false
# only to pause this daily background task. Incomplete provider snapshots remain
# recorded as deferred/failed and cannot drive listing-retirement decisions.
MARKET_UNIVERSE_RECONCILIATION_ENABLED=true
MARKET_UNIVERSE_MISSING_CONFIRMATIONS=3
ETF_HOLDINGS_CLASSIFICATION_REFRESH_ENABLED=false
ETF_HOLDINGS_CLASSIFICATION_MAX_PROFILES=50
ETF_HOLDINGS_CLASSIFICATION_MAX_ENRICHMENTS_PER_PROFILE=32
BENCHMARK_FAMILY_HOLDINGS_REFRESH_ENABLED=false
BENCHMARK_FAMILY_HOLDINGS_REFRESH_LOOKBACK_DATES=1
# Seed providers used to initialize DB-backed provider policies on first boot.
# Runtime routing, fallback, and scoring are then controlled from the DB.
DEFAULT_MARKET_DATA_PROVIDER=alpaca
DEFAULT_METADATA_PROVIDER=edgar
DEFAULT_EVENT_PROVIDER=alpaca
DEFAULT_DISCOVERY_PROVIDER=alpaca
DEFAULT_OPTIONS_PROVIDER=marketdata_app
ENABLE_LEGACY_YFINANCE_FALLBACK=false
IDENTIFIER_PROVIDER_PRIORITY=["openfigi"]
OPTION_QUOTE_HISTORY_PROVIDER_PRIORITY=["marketdata_app"]
TOKENIZED_PROVIDER_PRIORITY=["robinhood_tokens","xstocks","bybit_xstocks","gate_tradfi","kraken_xstocks","dinari","ondo_global_markets"]
# yfinance is deliberately absent from all new-workstation capability chains.
# Keep it only in an explicitly reviewed legacy configuration override.
PROVIDER_CHAIN_SEEDS={"account_usage":["marketdata_app","twelve_data","eodhd","binance"],"price_history":["alpaca","alpha_vantage"],"latest_price":["alpaca","alpha_vantage"],"universe_discovery":["alpaca","edgar","massive","nasdaq","finra_otc_directory","alpha_vantage"],"instrument_events":["alpaca","massive","edgar","finnhub","alpha_vantage"],"instrument_metadata":["edgar","massive"],"instrument_search":["edgar","massive","alpha_vantage"],"option_chain":["marketdata_app"],"tokenized_historical_prices":["dinari","ondo_global_markets"],"tokenized_corporate_actions":["robinhood_tokens","xstocks","dinari"]}
# Leave provider quota/entitlement seed settings unset unless replacing them
# with a complete, documentation-backed JSON contract. An empty override
# removes all routable provider limits and is intentionally not a fallback.
# Use __CODE_DEFAULT__ when no replacement map is intended. An explicit {}
# remains a deliberate empty override that removes routable provider policies.
PROVIDER_RATE_LIMIT_SEEDS=__CODE_DEFAULT__
PROVIDER_FRESHNESS_SEEDS=__CODE_DEFAULT__
PROVIDER_USAGE_PROFILE_SEEDS=__CODE_DEFAULT__
# Optional per-provider entitlement overrides. Omitted providers/capabilities
# remain unreviewed and are excluded from runtime chains until explicitly
# reviewed through /api/v1/providers/entitlements.
# Data provider credentials
# Alpaca: free paper trading account — alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_CORPORATE_ACTIONS_MAX_PAGES=0 # compatibility only; every continuation is persisted and resumed until complete
ALPACA_CORPORATE_ACTIONS_START_DATE=1900-01-01 # earliest requested provider window; never silently shorten history
ALPACA_REVIEWED_RESET= # optional plan-change override; native Market Data headers are authoritative by default
ALPACA_QUOTA_EVIDENCE= # optional evidence reference for the override
# Alpaca Basic is personal/non-commercial; permanent archive rights need an
# explicit written grant covering automated internal display and retention.
MASSIVE_CORPORATE_ACTIONS_MAX_PAGES=0 # legacy compatibility setting; Massive follows all cursors to completion
MASSIVE_REVIEWED_RESET= # optional provider reset override; public docs leave the minute boundary unspecified
MASSIVE_QUOTA_EVIDENCE= # current provider/plan evidence for a reviewed reset boundary
MASSIVE_MARKET_DATA_USE_AUTHORIZED=false # legacy per-provider control; owner-wide private-use decision below takes precedence
PROVIDER_OWNER_ACCEPTS_PROVIDER_TERMS_RISK=true # final owner decision: do not block private single-user automation/retention on provider terms
MASSIVE_MARKET_DATA_USE_AUTHORITY_REFERENCE= # provider approval/signed agreement reference; a terms-page URL is insufficient
MASSIVE_MARKET_DATA_USE_AUTHORITY_SCOPE= # exact scope: written_automated_persistent_archive_and_audience; terms URL/self-attestation is insufficient
MASSIVE_MARKET_DATA_USE_REVIEWED_AT=
MASSIVE_MARKET_DATA_USE_EXPIRES_AT=
# Massive / Polygon-compatible reference API
MASSIVE_API_KEY=
MARKETDATA_API_KEY= # Legacy Massive compatibility key; prefer MASSIVE_API_KEY
# Alpha Vantage free key
ALPHA_VANTAGE_API_KEY=
# Optional native-reset override; default is a rolling 24-hour safety envelope.
ALPHA_VANTAGE_REVIEWED_RESET=
ALPHA_VANTAGE_QUOTA_EVIDENCE=
# Free terms do not expressly establish permanent local response-archive or
# post-termination rights; route only with provider-specific written authority.
# FRED: free key — fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# FRED v1: remain disabled until provider quota scope and written database
# persistence rights are evidenced for the configured series.
FRED_REVIEWED_LIMIT_SCOPE=
FRED_REVIEWED_REQUESTS_PER_MINUTE=0
FRED_REVIEWED_QUOTA_EVIDENCE=
# FRED v1 does not publish the reset boundary for its 120/minute threshold.
# Set only after current provider/account evidence is reviewed.
FRED_REVIEWED_RESET=
FRED_RESET_EVIDENCE=
# FRED API keys are per application user; this shared backend key is supported
# only for an owner-only personal deployment unless per-user keys are added.
FRED_APPLICATION_USER_SCOPE=
FRED_APPLICATION_USER_SCOPE_EVIDENCE=
FRED_AUTOMATED_USE_AUTHORIZED=false
FRED_AUTOMATED_USE_AUTHORITY_EVIDENCE=
FRED_SERIES_RIGHTS_EVIDENCE={}
# CoinGecko Demo: current pricing documents 100 calls/min and 10,000 calls/month;
# an older public-API support article says 30/min for Demo. Code uses the current
# plan pricing contract. `/key` account usage is Pro-only; Demo usage is tracked
# through the application's durable request quota ledger.
COINGECKO_API_KEY=
COINGECKO_REVIEWED_PLAN=demo
COINGECKO_MARKET_DATA_USE_AUTHORIZED=false
COINGECKO_MARKET_DATA_USE_AUTHORITY_REFERENCE=
# Must equal written_api_use_archive_audience_attribution_and_retention_after_termination.
COINGECKO_MARKET_DATA_USE_AUTHORITY_SCOPE=
COINGECKO_MARKET_DATA_USE_REVIEWED_AT=
COINGECKO_MARKET_DATA_USE_EXPIRES_AT=
# EDGAR: no key; User-Agent is required by SEC — use real name + email
# Set a real application/contact value before enabling SEC calls; blank is intentionally fail-closed.
EDGAR_USER_AGENT=
# SEC publishes 10 requests/second but not a fixed reset boundary. The runtime
# uses a rolling one-second application envelope; this is an optional native
# reset override and requires current evidence.
EDGAR_REVIEWED_RESET=
EDGAR_QUOTA_EVIDENCE=
# Nasdaq Trader directory request identity (use an application-specific value)
NASDAQ_USER_AGENT=charting-platform market-data-universe
OPENFIGI_API_KEY=
OPENFIGI_TIMEOUT_SECONDS=10
# FINRA current OAuth API (short interest)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
FINRA_TOKEN_URL=https://ews.fip.finra.org/fip/rest/ews/oauth2/access_token
FINRA_API_BASE_URL=https://api.finra.org
FINRA_SHORT_INTEREST_URL=
FINRA_OTC_DAILY_LIST_URL=
FINRA_OTC_SOURCE_KIND=finra_otc_query_api # official Symbol Directory Query API; ORF remains optional with separate TRAQS entitlement
FINRA_OTC_SYMBOL_DIRECTORY_URL=https://api.finra.org/data/group/otcMarket/name/otcSecurityMaster
FINRA_OTC_INACTIVE_SECURITY_MASTER_URL=https://apidownload.finratraqs.org/DownloadHandler.ashx?action=DOWNLOAD&file=EQUITYMASTERIN&facility=ORF
# JSON operation -> reviewed conservative cold-refresh request charge. Both
# discover_universe_page and reconcile_universe_page are required; no 1-request
# default is inferred for the response-dependent DAPI pagination.
FINRA_OTC_OPERATION_COSTS={}
FINRA_OTC_SOURCE_REVIEWED=false
FINRA_OTC_SOURCE_EVIDENCE= # non-secret document or provider-confirmation reference
FINRA_OTC_REVIEWED_SOURCE_URL= # must exactly match the reviewed source endpoint
FINRA_OTC_REVIEWED_INACTIVE_SOURCE_URL= # required for finra_orf_security_master
FINRA_OTC_TERMS_REVIEWED=false
FINRA_OTC_COMPLETENESS_REVIEWED=false
FINRA_OTC_REDISTRIBUTION_REVIEWED=false
FINRA_OTC_POLL_INTERVAL_SECONDS=86400
FINRA_ORF_CUSIP_LICENSED=false
FINRA_ORF_CUSIP_LICENSE_EVIDENCE=
FINRA_ORF_REFRESH_TOKEN_STATE_FILE= # private durable file shared by API and worker
# Async FINRA result safety bound. Keep zero until a positive, reviewed
# per-download bound is supplied; zero is intentionally fail-closed.
FINRA_ASYNC_MAX_RESULT_BYTES=0
ALLOW_PAID_PROVIDER_ROUTING=false
PROVIDER_FREE_ONLY_CHECKPOINT=true
PROVIDER_CHECKPOINT_OPERATION_HOLDS=__CODE_DEFAULT__ # JSON provider -> operation -> reason map; replace only after exact operation review/live evidence
PROVIDER_ROUTING_ENABLED=true # false disables adapter calls while retaining provider/quota diagnostics
# Optional adapters (disabled until governance records reviewed entitlements)
TIINGO_API_KEY=
TIINGO_REVIEWED_PLAN=starter # starter, power, or custom; values follow current official plan documentation
TIINGO_CUSTOM_UNIQUE_SYMBOLS_PER_MONTH=0 # required only for custom plans; exact account allowance
TIINGO_CUSTOM_REQUESTS_PER_HOUR=0 # required only for custom plans
TIINGO_CUSTOM_REQUESTS_PER_DAY=0 # required only for custom plans
TIINGO_CUSTOM_BANDWIDTH_BYTES_PER_MONTH=0 # required only for custom plans; exact decimal bytes
TIINGO_CUSTOM_QUOTA_EVIDENCE= # required non-secret account/documentation reference for custom plan
TIINGO_PROVIDER_ARCHIVE_TERMS_AUTHORIZED=false # vendor-contract exception only; not owner storage consent
TIINGO_PROVIDER_ARCHIVE_TERMS_EVIDENCE=
# Application response-byte reservation budgets (per HTTP response), not
# provider-reported ceilings. EOD history is split into calendar-year requests.
TIINGO_OPERATION_BYTE_BOUNDS={"fetch_ohlcv":1048576,"fetch_latest_ohlcv":1048576,"get_current_price":65536,"bulk_fetch":1048576,"search_instruments":4194304,"get_instrument_profile":1048576}
# Tiingo's distinct-symbol and hourly reset anchors are provider-specific; the
# runtime uses rolling 31-day/one-hour safety envelopes by default. Native
# overrides remain optional and require evidence.
TIINGO_REVIEWED_UNIQUE_SYMBOL_RESET=
TIINGO_REVIEWED_HOURLY_RESET=
TIINGO_UNIQUE_SYMBOL_QUOTA_EVIDENCE=
TIINGO_HOURLY_QUOTA_EVIDENCE=
TWELVE_DATA_API_KEY=
TWELVE_DATA_PROVIDER_ARCHIVE_TERMS_AUTHORIZED=false # vendor-contract exception only; not owner storage consent
TWELVE_DATA_PROVIDER_ARCHIVE_TERMS_EVIDENCE=
FINNHUB_API_KEY=
# Optional native-reset overrides; defaults are rolling envelopes for each
# documented minute/second ceiling.
FINNHUB_REVIEWED_MINUTE_RESET=
FINNHUB_REVIEWED_SECOND_RESET=
FINNHUB_MINUTE_QUOTA_EVIDENCE=
FINNHUB_SECOND_QUOTA_EVIDENCE=
MARKETSTACK_API_KEY=
# Explicit Marketstack MIC/exchange code for venue-scoped discovery; blank is fail-closed.
MARKETSTACK_DISCOVERY_EXCHANGE=
MARKETSTACK_REVIEWED_MONTHLY_LIMIT=100
MARKETSTACK_REVIEWED_MONTHLY_RESET=
MARKETSTACK_QUOTA_EVIDENCE=
MARKETSTACK_DISCOVERY_MAX_PAGE_COST=0 # unknown until Marketstack confirms exchange-listing page billing
MARKETSTACK_DISCOVERY_COST_EVIDENCE=
MARKETSTACK_PROVIDER_ARCHIVE_TERMS_AUTHORIZED=false # vendor-contract exception only; not owner storage consent
MARKETSTACK_PROVIDER_ARCHIVE_TERMS_EVIDENCE=
EODHD_API_KEY=
EODHD_REVIEWED_MINUTE_LIMIT=0
EODHD_REVIEWED_MINUTE_RESET=
EODHD_MINUTE_QUOTA_EVIDENCE=
EODHD_PROVIDER_DISPLAY_TERMS_AUTHORIZED=false # vendor display entitlement only; not owner storage consent
EODHD_PROVIDER_DISPLAY_TERMS_EVIDENCE=
TRADIER_API_KEY=
MARKETDATA_APP_API_KEY=
# MarketData.app account plan/limit must be configured together. The admin
# account-usage probe may run before this configuration to inspect native
# counters. Supported daily-credit plans: free_forever=100,
# starter_trial=10000, trader_trial=100000, starter=10000, trader=100000.
# At trial expiry, entitlement/quota automatically fall back to Free Forever
# at 100/day. Paid plans are non-routable by default; the explicit legacy
# paid-routing toggle only enables a reviewed plan and is not aggregate cost
# admission or authorization to activate a paid plan.
MARKETDATA_APP_REVIEWED_PLAN=
MARKETDATA_APP_REVIEWED_DAILY_CREDIT_LIMIT=0
# Required for starter_trial/trader_trial; ISO-8601 timezone-aware expiry.
MARKETDATA_APP_REVIEWED_PLAN_EXPIRES_AT=
MARKETDATA_APP_PROVIDER_RETENTION_TERMS_AUTHORIZED=false # vendor-contract exception only; not owner storage consent
MARKETDATA_APP_PROVIDER_RETENTION_TERMS_EVIDENCE=
# Current option-chain reads are billed per returned symbol. Set a positive,
# operator-reviewed maximum for the exact chain filters before routing; zero
# keeps this response-dependent operation fail-closed.
MARKETDATA_APP_OPTION_CHAIN_MAX_SYMBOLS=0
FMP_API_KEY=
FMP_PROVIDER_ARCHIVE_TERMS_AUTHORIZED=false # vendor-contract exception only; not owner storage consent
FMP_PROVIDER_ARCHIVE_TERMS_EVIDENCE=
# JSON operation -> reviewed maximum response bytes. Empty/partial maps remain
# non-routable because FMP publishes a rolling bandwidth pool without universal endpoint ceilings.
FMP_OPERATION_BYTE_BOUNDS={"fetch_ohlcv":1048576,"fetch_latest_ohlcv":1048576,"get_current_price":65536,"bulk_fetch":1048576,"get_instrument_profile":262144,"fetch_market_events":8388608,"discover_universe_page":33554432,"fetch_account_usage":65536}
# Match the FMP account's plan; published request/bandwidth pools and their
# evidence URLs fall back to the official plan/FAQ pages when overrides are blank.
FMP_REVIEWED_PLAN=basic
# Current Basic key received HTTP 402 from stable/stock-list; enable only after
# confirming this account has access to that endpoint.
FMP_STOCK_LIST_ENTITLED=false
# FMP sources conflict on a universal fixed Basic daily-call reset. Leave
# blank to retain the rolling 24-hour safety window; set only with
# account-specific reset evidence. Higher-tier windows follow the same rule.
FMP_REVIEWED_DAILY_RESET= # optional account-reviewed Basic reset boundary
FMP_REVIEWED_CALL_RESET= # optional native call-pool boundary for the selected tier
FMP_CALL_QUOTA_EVIDENCE= # optional evidence override; otherwise official plan/FAQ URLs
FMP_REVIEWED_BANDWIDTH_RESET=
FMP_DAILY_QUOTA_EVIDENCE= # optional evidence override; account usage baseline is separate
FMP_BANDWIDTH_QUOTA_EVIDENCE= # optional evidence override; account usage baseline is separate
XSTOCKS_API_KEY=
# xStocks public reads remain blocked until current automation-use and
# deployment-jurisdiction evidence are explicitly reviewed.
XSTOCKS_MARKET_DATA_USE_AUTHORIZED=false
XSTOCKS_MARKET_DATA_USE_AUTHORITY_REFERENCE=
XSTOCKS_MARKET_DATA_USE_AUTHORITY_SCOPE=
XSTOCKS_MARKET_DATA_USE_REVIEWED_AT=
XSTOCKS_MARKET_DATA_USE_EXPIRES_AT=
BYBIT_XSTOCKS_MARKET_DATA_USE_AUTHORIZED=false
BYBIT_XSTOCKS_MARKET_DATA_USE_AUTHORITY_REFERENCE=
BYBIT_XSTOCKS_MARKET_DATA_USE_AUTHORITY_SCOPE=
BYBIT_XSTOCKS_MARKET_DATA_USE_REVIEWED_AT=
BYBIT_XSTOCKS_MARKET_DATA_USE_EXPIRES_AT=
BYBIT_XSTOCKS_MARKET_DATA_USE_EGRESS_JURISDICTION_AUTHORIZED=false
BYBIT_XSTOCKS_MARKET_DATA_USE_EGRESS_JURISDICTION_EVIDENCE=
DINARI_API_KEY_ID=
DINARI_API_SECRET_KEY=
DINARI_API_BASE_URL=https://api-enterprise.sandbox.dinari.com/api/v2
# Leave at the code default until Dinari confirms the Sandbox quota contract.
DINARI_SANDBOX_QUOTA_PROFILE=__CODE_DEFAULT__
# Opt-in, non-secret controls for a one-read Sandbox connectivity canary.
# The shared quota ledger enforces one local request per UTC day, not a claim
# about Dinari's unpublished quota. Recurring tests/routing still require a
# reviewed DINARI_SANDBOX_QUOTA_PROFILE. MAX_REQUESTS must be exactly 1.
DINARI_SANDBOX_CANARY_AUTHORIZED=false
DINARI_SANDBOX_CANARY_AUTHORITY_REFERENCE=
DINARI_SANDBOX_CANARY_MAX_REQUESTS=
ONDO_GLOBAL_MARKETS_API_KEY=
IBKR_READ_ONLY_URL=
IBKR_READ_ONLY_SESSION_COOKIE=
