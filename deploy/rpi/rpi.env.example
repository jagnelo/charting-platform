# Copy to .ai/deploy/rpi.env. Never commit the copy or paste secrets into logs.
RPI_SSH_TARGET=charting-rpi.local
RPI_DEPLOY_ROOT=/opt/charting-platform
RPI_HTTP_PORT=8080
# Confirm this from `uname -m` on the Pi. Pi OS 32-bit normally uses
# linux/arm/v7; Pi OS 64-bit uses linux/arm64.
RPI_DOCKER_PLATFORM=linux/arm/v7
RPI_SSH_CONNECT_TIMEOUT=10
RPI_SMOKE_USERNAME=
RPI_SMOKE_PASSWORD=
RPI_REQUIRE_CI_REPLAY=true
POSTGRES_IMAGE=postgres:16-alpine@sha256:c05eced0bdb41ea9b95a656472a6aa4d50cad0d8a2e33d14eb1c53fd6204f2ae2
REDIS_IMAGE=redis:7-alpine@sha256:4ab05801a605362b921756ce9dff4893add29c678076fe49a72d8cc3278806c6
