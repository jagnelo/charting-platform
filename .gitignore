# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# uv

# Distribution / packaging
dist/
build/
*.egg-info/

# ── Environment files ─────────────────────────────────────────────────────────
# Never commit secrets — use .env.dev for local dev, root .env for Docker
.env
backend/.env
backend/.env.dev

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
coverage.xml
backend/coverage-combined.xml
coverage_html/
.coverage
htmlcov/

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep migrations in version control — do NOT ignore alembic/versions/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo
.vite/
test-results/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep both compose files in version control

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp

# Generated local orchestration state. Tracked branch documentation under
# ops/workstreams is deliberately not ignored.
.ai/worktrees/
.ai/runtime/
.ai/validation/
.ai/deploy/
.ai/config/
.ai/integration/
.ai/staging-attempts/
.ai/session-claims/
.ai/builders/
.ai/testcontainers/
.ai/locks/
.ai/*.lock
# Local degraded-master state is generated by the integration publisher and is
# inspected by the guarded remediation path; it is never a source change.
.ai/master-degraded.json
.ai/staging-degraded.json
ci-retry-decision.json
