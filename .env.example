# FINRA Gateway OAuth credentials and optional endpoint overrides.
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
FINRA_TOKEN_URL=https://ews.fip.finra.org/fip/rest/ews/oauth2/access_token
FINRA_ORF_USERNAME= # assigned TRAQS username; not the email address
FINRA_ORF_REFRESH_TOKEN= # TRAQS Programmatic API refresh token; secret
# Host-side durable state directory for token rotation; keep it outside the repo.
FINRA_ORF_REFRESH_TOKEN_STATE_HOST_DIR=
FINRA_ORF_TOKEN_URL=https://apidownload.finratraqs.org/refresh
FINRA_API_BASE_URL=https://api.finra.org
FINRA_SHORT_INTEREST_URL=
FINRA_OTC_DAILY_LIST_URL=
