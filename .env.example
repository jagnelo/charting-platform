FINRA_OTC_TERMS_REVIEWED=false
FINRA_OTC_COMPLETENESS_REVIEWED=false
FINRA_OTC_REDISTRIBUTION_REVIEWED=false
FINRA_OTC_POLL_INTERVAL_SECONDS=86400 # daily complete snapshot; Daily List supplies lifecycle deltas between snapshots
FINRA_ORF_CUSIP_LICENSED=false
FINRA_ORF_CUSIP_LICENSE_EVIDENCE= # FINRA no-CUSIP entitlement confirmation or separate CGS license reference; required before ORF routing
FINRA_ASYNC_MAX_RESULT_BYTES=0 # positive reviewed bound enables durable monthly-byte reservation for signed async results
ALLOW_PAID_PROVIDER_ROUTING=false
PROVIDER_FREE_ONLY_CHECKPOINT=true # shared checkpoint gate; overrides paid-routing opt-in until full-roadmap mode is intentionally selected
PROVIDER_CHECKPOINT_OPERATION_HOLDS=__CODE_DEFAULT__ # JSON provider -> operation -> reason map; replace only after exact operation review/live evidence
PROVIDER_ROUTING_ENABLED=true # false disables adapter calls while retaining provider/quota diagnostics
INSTRUMENT_DISCOVERY_PAGE_DELAY_SECONDS=0.75
INSTRUMENT_METADATA_DELAY_SECONDS=1.0
INSTRUMENT_IDENTIFIER_DELAY_SECONDS=1.0
INSTRUMENT_DAILY_METADATA_CAP=750
INSTRUMENT_DAILY_IDENTIFIER_CAP=250
PROVIDER_MAX_CONCURRENCY=2
OPTION_CHAIN_REFRESH_HORIZON_DAYS=45
PROVIDER_REQUEST_LOG_RETENTION_DAYS=30
# Durable quota admission ledger shared by this host's app, direct live probes,
# and all worktree containers that share these provider accounts. Keep the
# directory owner-only and outside the repository. Multi-host CI/deployment
# environments should use a separately provisioned PostgreSQL URL instead.
PROVIDER_QUOTA_LEDGER_PATH=~/.config/charting-platform/provider-quota/usage.sqlite3
PROVIDER_QUOTA_LEDGER_DATABASE_URL=
PROVIDER_QUOTA_LEDGER_RETENTION_DAYS=180
# Optional non-secret aliases; equal scopes share budgets, distinct accounts
# use separate labels. Keys may be provider names or provider:scope pairs.
PROVIDER_QUOTA_ACCOUNT_SCOPES={}
# Only mark an account scope true after confirming all users share the same
# durable quota coordinator; this permits automatic zero baseline at reset.
PROVIDER_QUOTA_EXCLUSIVE_ACCOUNT_SCOPES={}
PROVIDER_QUOTA_CONCURRENCY_LEASE_GRACE_SECONDS=10
PROVIDER_LIVE_USAGE_LEDGER=
# Owner-private archive of redacted response bodies captured by direct live probes.
PROVIDER_LIVE_RESPONSE_ARCHIVE=
# Non-secret environment/account label for direct live-test receipts; set a
# distinct value per local worktree, CI environment, and deployment account.
