# ── Root .env — Docker Compose deployments ────────────────────────────────────
# Copy this file to .env (at the project root, next to docker-compose.yml)
# and fill in your values. This file is read by Docker Compose to interpolate
# ${VAR} references in docker-compose.yml.
#
# NEVER commit .env to version control.

# ── PostgreSQL credentials ────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chartingdb

# ── Security — REQUIRED ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-min-32-chars

# ── CORS — set to your server's hostname/IP ───────────────────────────────────
CORS_ORIGINS=["http://localhost","http://your-nas-ip"]

# ── Push notifications (optional — leave blank to disable) ───────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── Alert engine ──────────────────────────────────────────────────────────────
ALERT_POLL_INTERVAL=60

# ── Provider-backed instrument maintenance ───────────────────────────────────
# Set true only when an ARQ worker should run scheduled provider maintenance.
INSTRUMENT_SYNC_SCHEDULE_ENABLED=false
# Seed providers used to initialize DB-backed provider policies on first boot.
# After startup, routing is controlled from the database / Settings UI.
DEFAULT_MARKET_DATA_PROVIDER=alpaca
DEFAULT_METADATA_PROVIDER=edgar
DEFAULT_EVENT_PROVIDER=alpaca
DEFAULT_DISCOVERY_PROVIDER=alpaca
DEFAULT_OPTIONS_PROVIDER=yfinance
ENABLE_LEGACY_YFINANCE_FALLBACK=false
IDENTIFIER_PROVIDER_PRIORITY=["openfigi"]
# yfinance is an explicit legacy/options fallback only; it is not in the new
# workstation's default market-data, metadata, discovery, or identifier chains.
OPTION_QUOTE_HISTORY_PROVIDER_PRIORITY=["yfinance"]
PROVIDER_CHAIN_SEEDS={"price_history":["alpaca","alpha_vantage","binance","fred"],"latest_price":["alpaca","alpha_vantage","binance","fred"],"universe_discovery":["alpaca","massive","alpha_vantage","binance","coingecko"],"instrument_events":["alpaca","edgar"],"instrument_metadata":["edgar","coingecko"],"instrument_search":["edgar","alpaca","massive","alpha_vantage","coingecko"],"option_chain":["yfinance"]}
PROVIDER_RATE_LIMIT_SEEDS={}
PROVIDER_FRESHNESS_SEEDS={}
PROVIDER_USAGE_PROFILE_SEEDS={}
# ── Data provider credentials ─────────────────────────────────────────────────
# Alpaca Markets — free paper trading account is sufficient for all data endpoints
# Create account + Paper Trading API keys at: alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
# FRED — completely free key, for identification only
# Register at: fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# CoinGecko — free Demo key; optional but raises rate limit from ~30 to ~500 req/min
# Register at: coingecko.com/en/api
COINGECKO_API_KEY=
# SEC EDGAR — no key needed; User-Agent header is required by SEC guidelines
# Use your real name + contact email
EDGAR_USER_AGENT=charting-platform your.email@example.com
OPENFIGI_API_KEY=
OPENFIGI_TIMEOUT_SECONDS=10
# Optional reference corroboration (Massive formerly Polygon); no core path requires it
MASSIVE_API_KEY=
ALPHA_VANTAGE_API_KEY=
MARKETDATA_API_KEY=
FMP_API_KEY=
INSTRUMENT_DISCOVERY_PAGE_DELAY_SECONDS=0.75
INSTRUMENT_METADATA_DELAY_SECONDS=1.0
INSTRUMENT_IDENTIFIER_DELAY_SECONDS=1.0
INSTRUMENT_DAILY_METADATA_CAP=750
INSTRUMENT_DAILY_IDENTIFIER_CAP=250
PROVIDER_MAX_CONCURRENCY=2
OPTION_CHAIN_REFRESH_HORIZON_DAYS=45
PROVIDER_REQUEST_LOG_RETENTION_DAYS=30
LATEST_PRICE_SNAPSHOT_RETENTION_DAYS=30
INSTRUMENT_SEARCH_SNAPSHOT_RETENTION_DAYS=14
UNIVERSE_DISCOVERY_SNAPSHOT_RETENTION_DAYS=30
INSTRUMENT_PROFILE_SNAPSHOT_RETENTION_DAYS=365
INSTRUMENT_IDENTIFIER_SNAPSHOT_RETENTION_DAYS=3650
PROVIDER_SUPPORT_SUPPORTED_TTL_SECONDS=2592000
PROVIDER_SUPPORT_UNSUPPORTED_TTL_SECONDS=604800

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
